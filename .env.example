# Copy this file to .env and change the values for THIS machine.
# .env is git-ignored, so each machine keeps its own.

# "file" = talk to real SketchUp through the queue folder (Windows)
# "mock" = fake SketchUp in memory (Mac, for development)
UMD_TRANSPORT=mock

# The queue folder the SketchUp extension watches. Must be the same path
# as QUEUE_DIR in the SketchUp loader file (umd_bridge.rb in the Plugins folder).
UMD_QUEUE_DIR=E:/Cowork_Field/Thesis_SketchUp/agent_queue

# How long to wait for SketchUp to answer one command (milliseconds).
# Big models are slow: saving a copy of a 600 MB file can take a minute.
UMD_COMMAND_TIMEOUT_MS=120000

# How often to look for an answer file (milliseconds).
UMD_POLL_MS=250

# Local AI (used from Week 2)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-instruct

# Paid AI providers stay OFF unless you deliberately turn them on.
UMD_ALLOW_PAID=false
