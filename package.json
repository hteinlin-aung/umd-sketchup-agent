{
  "name": "umd-sketchup-agent",
  "version": "0.1.0",
  "private": true,
  "description": "AI-assisted modelling for SketchUp 2025: written instructions -> validated operations -> fixed Ruby tools -> checked, saved copy.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ruby": "ruby tests/ruby/args_test.rb && ruby tests/ruby/bridge_test.rb",
    "typecheck": "tsc --noEmit",
    "ping": "tsx src/cli/ping.ts",
    "smoke": "tsx src/cli/smoke.ts",
    "smoke:mock": "tsx src/cli/smoke.ts --mock"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.4"
  }
}
